# deploy/install.sh writes this file for you. If you edit it by hand, keep every value in
# 'single quotes': Docker Compose expands "$" in unquoted values (it breaks OAuth secrets).

# --- Telegram -------------------------------------------------------------------------------
# Token de @BotFather
TELEGRAM_BOT_TOKEN='123456:ABC-DEF...'
# Credenciales de https://my.telegram.org (las usa el servidor local de la Bot API)
TELEGRAM_API_ID='1234567'
TELEGRAM_API_HASH='0123456789abcdef0123456789abcdef'

# --- Dominio y HTTPS ------------------------------------------------------------------------
# Nombre público del servidor. Con DuckDNS: NOMBRE.duckdns.org (https://www.duckdns.org)
DOMAIN='nombre.duckdns.org'
# Token de DuckDNS: deploy/duckdns-update.sh mantiene el dominio apuntando a la IP del VPS
DUCKDNS_TOKEN=''
# Email para la cuenta de Let's Encrypt (avisos de caducidad de certificados)
ACME_EMAIL='tu@email.com'
# URL pública para los redirect URI de OAuth. Vacío = https://DOMAIN
PUBLIC_BASE_URL=''
# Email de contacto que aparece en la página /privacy (opcional)
CONTACT_EMAIL=''

# Clave para cifrar las credenciales de cada chat. Genérala con:
#   openssl rand -base64 32 | tr '+/' '-_'
# ¡No la pierdas ni la cambies! Sin ella no se pueden leer las configuraciones guardadas.
ENCRYPTION_KEY=''

# --- Google Drive (opcional) ----------------------------------------------------------------
# Redirect URI: https://<DOMAIN>/oauth/google/callback
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''

# --- OneDrive (opcional) --------------------------------------------------------------------
# Redirect URI: https://<DOMAIN>/oauth/microsoft/callback
MS_CLIENT_ID=''
MS_CLIENT_SECRET=''
# "common" admite cuentas personales y de empresa
MS_TENANT='common'

# --- Imagen del bot -------------------------------------------------------------------------
# Etiqueta de ghcr.io/jpchaconr/telebot-photos: latest, sha-xxxxxxx o vX.Y.Z.
# deploy/update.sh la cambia en cada despliegue.
BOT_TAG='latest'

# --- Comportamiento -------------------------------------------------------------------------
# Zona horaria para nombrar los archivos y las carpetas por mes
TIMEZONE='Europe/Madrid'
# Subidas simultáneas
UPLOAD_CONCURRENCY='3'
# Reintentos antes de dar un archivo por fallido
MAX_ATTEMPTS='5'
# Reacción que pone el bot al guardar un archivo (vacío = ninguna)
SUCCESS_REACTION='👍'
# IDs de Telegram que pueden usar /configurar, separados por comas (vacío = cualquier admin)
ALLOWED_CONFIGURATORS=''
LOG_LEVEL='INFO'
