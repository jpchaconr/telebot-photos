# --- Telegram -------------------------------------------------------------------------------
# Token de @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Credenciales de https://my.telegram.org (las usa el servidor local de la Bot API)
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# --- Servidor web ---------------------------------------------------------------------------
# Dominio que apunta a este servidor (Caddy obtiene el certificado HTTPS automáticamente)
DOMAIN=bot.example.com
# URL pública usada en los redirect URI de OAuth
PUBLIC_BASE_URL=https://bot.example.com

# Clave para cifrar las credenciales de cada chat. Genérala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ¡No la pierdas! Sin ella no se pueden leer las configuraciones guardadas.
ENCRYPTION_KEY=

# --- Google Drive (opcional) ----------------------------------------------------------------
# Redirect URI: https://<DOMAIN>/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OneDrive (opcional) --------------------------------------------------------------------
# Redirect URI: https://<DOMAIN>/oauth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" admite cuentas personales y de empresa
MS_TENANT=common

# --- Comportamiento -------------------------------------------------------------------------
# Zona horaria para nombrar los archivos y las carpetas por mes
TIMEZONE=Europe/Madrid
# Subidas simultáneas
UPLOAD_CONCURRENCY=3
# Reintentos antes de dar un archivo por fallido
MAX_ATTEMPTS=5
# Reacción que pone el bot al guardar un archivo (vacío = ninguna)
SUCCESS_REACTION=👍
# IDs de Telegram que pueden usar /configurar, separados por comas (vacío = cualquier admin)
ALLOWED_CONFIGURATORS=
LOG_LEVEL=INFO
